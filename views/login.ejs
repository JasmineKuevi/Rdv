<%- include('partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="card soft-card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <img src="/logo.jpg" alt="Logo" width="48" height="48" class="rounded-circle mb-2" onerror="this.style.display='none'">
                            <h1 class="h3 fw-bold mb-1">Connexion</h1>
                            <p class="text-muted small">Accédez à votre espace Médilink sécurisé.</p>
                        </div>

                        <!-- Role Selector Tabs -->
                        <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded-3" id="roleTabs">
                            <li class="nav-item">
                                <button type="button" class="nav-link py-2 <%= role === 'patient' ? 'active' : '' %>" onclick="setRole('patient', 'patient@medilink.com')">
                                    <i class="bi bi-person me-1"></i> Patient
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link py-2 <%= role === 'medecin' ? 'active' : '' %>" onclick="setRole('medecin', 'mensah@medilink.com')">
                                    <i class="bi bi-heart-pulse me-1"></i> Médecin
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link py-2 <%= role === 'admin' ? 'active' : '' %>" onclick="setRole('admin', 'admin@medilink.com')">
                                    <i class="bi bi-shield-lock me-1"></i> Admin
                                </button>
                            </li>
                        </ul>

                        <form action="/login" method="POST" id="loginForm">
                            <input type="hidden" name="role" id="roleInput" value="<%= role || 'patient' %>">
                            
                            <div class="mb-3">
                                <label for="email" class="form-label fw-semibold">Adresse e-mail</label>
                                <input type="email" class="form-control" id="email" name="email" value="<%= email || (role === 'admin' ? 'admin@medilink.com' : (role === 'medecin' ? 'mensah@medilink.com' : 'patient@medilink.com')) %>" required>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label fw-semibold">Mot de passe</label>
                                <input type="password" class="form-control" id="password" name="password" value="password" required>
                                <div class="form-text">Mot de passe par défaut : <code>password</code></div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold mt-2">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                            </button>
                        </form>

                        <div class="mt-4 pt-3 border-top text-center">
                            <p class="text-muted small mb-0">
                                Nouveau sur Médilink ?
                                <a href="/register/patient" class="text-decoration-none fw-semibold">Créer un compte patient</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
function setRole(r, defaultEmail) {
    document.getElementById('roleInput').value = r;
    document.getElementById('email').value = defaultEmail;
    
    document.querySelectorAll('#roleTabs button').forEach(btn => {
        btn.classList.remove('active');
    });
    event.target.closest('button').classList.add('active');
}
</script>

<%- include('partials/footer') %>
