<%- include(user ? 'partials/app-header' : 'partials/header') %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0 fw-bold text-primary">Prendre un rendez-vous</h1>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Retour
    </a>
  </div>

  <div class="card p-4 shadow-sm border-0 bg-white" style="max-width: 800px;">
    <form method="POST" action="/rendezvous">
      <% if (!user) { %>
        <div class="alert alert-warning mb-4">
          <i class="bi bi-info-circle me-1"></i>
          Vous n'êtes pas connecté. Pour un suivi personnalisé, vous pouvez renseigner votre nom ci-dessous ou 
          <a href="/login?role=patient" class="alert-link">vous connecter d'abord</a>.
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold" for="patient_name">Votre nom complet <span class="text-danger">*</span></label>
          <input type="text" id="patient_name" name="patient_name" class="form-control" placeholder="Ex: Jean Kouassi" required>
        </div>
      <% } %>

      {{-- Sélection du médecin --}}
      <div class="mb-3">
        <label class="form-label fw-semibold" for="doctor_id">Médecin praticien <span class="text-danger">*</span></label>
        <select id="doctor_id" name="doctor_id" class="form-select form-select-lg" required>
          <option value="">Sélectionner un médecin…</option>
          <% doctors.forEach(function(d) { %>
            <option value="<%= d.id %>" <%= (prefillDoctor == d.id) ? 'selected' : '' %>>
              Dr <%= d.name %> — <%= d.specialite %> (<%= d.centre_sante %>, <%= d.ville %>)
            </option>
          <% }); %>
        </select>
        <div class="form-text">Choisissez le praticien souhaité dans la liste de nos spécialistes.</div>
      </div>

      {{-- Date & heure --}}
      <div class="mb-3">
        <label class="form-label fw-semibold" for="scheduled_at">Date et heure souhaitées <span class="text-danger">*</span></label>
        <input id="scheduled_at" type="datetime-local" name="scheduled_at" class="form-control form-control-lg" required>
        <div class="form-text">Sélectionnez un créneau horaire.</div>
      </div>

      {{-- Motif --}}
      <div class="mb-4">
        <label class="form-label fw-semibold" for="reason">Motif de consultation</label>
        <textarea id="reason" name="reason" rows="3" class="form-control" placeholder="Ex: Contrôle de routine, douleurs thoraciques, renouvellement d'ordonnance…"></textarea>
        <div class="form-text">Quelques précisions permettent au praticien de préparer votre consultation.</div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary btn-lg fw-semibold px-4">
          <i class="bi bi-calendar-check me-2"></i> Confirmer le rendez-vous
        </button>
        <a href="<%= user ? '/patient/dashboard' : '/' %>" class="btn btn-outline-secondary btn-lg">Annuler</a>
      </div>
    </form>
  </div>

  <div class="alert alert-info mt-4" style="max-width: 800px;">
    <i class="bi bi-info-circle me-2"></i>
    Les demandes de rendez-vous sont traitées immédiatement. Vous recevrez une notification de confirmation sur votre espace personnel.
  </div>
</div>

<script>
  (function () {
    const input = document.getElementById('scheduled_at');
    if (!input) return;
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    const rounded = new Date(Math.ceil(now.getTime() / (5*60*1000)) * (5*60*1000));
    input.min = rounded.toISOString().slice(0,16);
    // Set default value tomorrow at 10:00
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    tomorrow.setHours(10, 0, 0, 0);
    tomorrow.setMinutes(tomorrow.getMinutes() - tomorrow.getTimezoneOffset());
    input.value = tomorrow.toISOString().slice(0,16);
  })();
</script>

<%- include(user ? 'partials/app-footer' : 'partials/footer') %>
