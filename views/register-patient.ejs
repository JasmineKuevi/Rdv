<%- include('partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card soft-card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h1 class="h3 fw-bold mb-1">Inscription Patient</h1>
                            <p class="text-muted small">Créez votre dossier patient en quelques instants.</p>
                        </div>

                        <form action="/register/patient" method="POST">
                            <div class="mb-3">
                                <label for="name" class="form-label fw-semibold">Nom complet <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="name" name="name" placeholder="Ex: Jean Kouassi" required>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label fw-semibold">Adresse e-mail <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="email" name="email" placeholder="patient@exemple.com" required>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label for="phone" class="form-label fw-semibold">Téléphone</label>
                                    <input type="tel" class="form-control" id="phone" name="phone" placeholder="+228 90 00 00 00">
                                </div>
                                <div class="col-md-6">
                                    <label for="dob" class="form-label fw-semibold">Date de naissance</label>
                                    <input type="date" class="form-control" id="dob" name="dob">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="address" class="form-label fw-semibold">Adresse / Quartier</label>
                                <input type="text" class="form-control" id="address" name="address" placeholder="Ex: Lomé, Totsi">
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label for="password" class="form-label fw-semibold">Mot de passe <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" id="password" name="password" minlength="6" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="password_confirmation" class="form-label fw-semibold">Confirmer mot de passe <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" id="password_confirmation" name="password_confirmation" minlength="6" required>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold mt-3">
                                <i class="bi bi-person-check me-2"></i>Créer mon compte
                            </button>
                        </form>

                        <div class="mt-4 pt-3 border-top text-center">
                            <p class="text-muted small mb-0">
                                Vous avez déjà un compte ?
                                <a href="/login?role=patient" class="text-decoration-none fw-semibold">Connectez-vous</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
