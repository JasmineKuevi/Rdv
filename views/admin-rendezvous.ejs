<%- include('partials/app-header') %>

<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Tous les rendez-vous</h1>
      <p class="text-muted mb-0">Consultez l'ensemble des rendez-vous enregistrés dans le système.</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h2 class="h5 fw-bold mb-0 text-dark">
        <i class="bi bi-calendar3 me-2 text-primary"></i>Liste complète (<%= appointments.length %>)
      </h2>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">ID</th>
              <th>Patient</th>
              <th>Médecin</th>
              <th>Date & Heure</th>
              <th>Motif</th>
              <th>Statut</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% appointments.forEach(function(a) { %>
              <tr>
                <td class="ps-4 fw-semibold text-muted">#<%= a.id %></td>
                <td><strong class="text-dark"><%= a.patient_name %></strong></td>
                <td>
                  <div class="fw-semibold">Dr <%= a.doctor_name %></div>
                  <small class="text-muted"><%= a.doctor_specialite %></small>
                </td>
                <td>
                  <%= new Date(a.scheduled_at).toLocaleDateString('fr-FR') %> à <%= new Date(a.scheduled_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td><small class="text-muted"><%= a.reason || 'Consultation' %></small></td>
                <td>
                  <% if (a.status === 'confirmed') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Confirmé</span>
                  <% } else if (a.status === 'pending') { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">En attente</span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Effectué</span>
                  <% } %>
                </td>
                <td class="text-end pe-4">
                  <form action="/rendezvous/<%= a.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Supprimer ce rendez-vous ?');" style="display:inline;">
                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-footer') %>
