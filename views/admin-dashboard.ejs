<%- include('partials/app-header') %>

<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Tableau de bord Administrateur</h1>
      <p class="text-muted mb-0">Supervisez l'ensemble des utilisateurs, praticiens et rendez-vous de la plateforme.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/users/create" class="btn btn-primary fw-semibold">
        <i class="bi bi-person-plus me-1"></i> Nouvel utilisateur
      </a>
    </div>
  </div>

  <!-- 4 KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm p-4 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold">Total Utilisateurs</span>
            <h2 class="fw-bold mb-0 mt-2 text-dark"><%= stats.totalUsers %></h2>
          </div>
          <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary fs-3">
            <i class="bi bi-people-fill"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm p-4 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold">Patients Inscrits</span>
            <h2 class="fw-bold mb-0 mt-2 text-success"><%= stats.totalPatients %></h2>
          </div>
          <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success fs-3">
            <i class="bi bi-person-check-fill"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm p-4 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold">Médecins Praticiens</span>
            <h2 class="fw-bold mb-0 mt-2 text-warning"><%= stats.totalDoctors %></h2>
          </div>
          <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning fs-3">
            <i class="bi bi-hospital"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm p-4 bg-white h-100">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold">Total Rendez-vous</span>
            <h2 class="fw-bold mb-0 mt-2 text-info"><%= stats.totalAppointments %></h2>
          </div>
          <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info fs-3">
            <i class="bi bi-calendar-event"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Users and Recent Appointments -->
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm bg-white mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h2 class="h5 fw-bold mb-0 text-dark">
            <i class="bi bi-people me-2 text-primary"></i>Derniers utilisateurs inscrits
          </h2>
          <a href="/admin/users" class="btn btn-sm btn-outline-primary">Voir tous</a>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">Nom</th>
                  <th>Email</th>
                  <th>Rôle</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% recentUsers.forEach(function(u) { %>
                  <tr>
                    <td class="ps-3">
                      <div class="d-flex align-items-center gap-2">
                        <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.name) %>&background=005BAC&color=fff&size=48" class="rounded-circle" width="32" height="32" alt="Avatar">
                        <span class="fw-semibold text-dark"><%= u.name %></span>
                      </div>
                    </td>
                    <td><span class="text-muted small"><%= u.email %></span></td>
                    <td>
                      <% if (u.role === 'admin') { %>
                        <span class="badge bg-danger-subtle text-danger border">Admin</span>
                      <% } else if (u.role === 'medecin') { %>
                        <span class="badge bg-warning-subtle text-warning-emphasis border">Médecin</span>
                      <% } else { %>
                        <span class="badge bg-success-subtle text-success border">Patient</span>
                      <% } %>
                    </td>
                    <td><small class="text-muted"><%= u.created_at || 'Récemment' %></small></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card border-0 shadow-sm bg-white mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h2 class="h5 fw-bold mb-0 text-dark">
            <i class="bi bi-clock-history me-2 text-primary"></i>Rendez-vous récents
          </h2>
          <a href="/admin/rendez-vous" class="btn btn-sm btn-outline-primary">Tous</a>
        </div>
        <div class="card-body p-0">
          <div class="list-group list-group-flush">
            <% recentAppointments.forEach(function(a) { %>
              <div class="list-group-item p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <strong class="text-dark"><%= a.patient_name %></strong>
                  <span class="badge <%= a.status === 'confirmed' ? 'bg-success' : 'bg-warning text-dark' %>">
                    <%= a.status %>
                  </span>
                </div>
                <div class="text-muted small mb-1">Dr <%= a.doctor_name %> (<%= a.doctor_specialite %>)</div>
                <div class="text-secondary small">
                  <i class="bi bi-calendar me-1"></i><%= new Date(a.scheduled_at).toLocaleDateString('fr-FR') %> à <%= new Date(a.scheduled_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-footer') %>
