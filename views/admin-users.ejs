<%- include('partials/app-header') %>

<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Gestion des utilisateurs</h1>
      <p class="text-muted mb-0">Consultez, modifiez ou ajoutez des comptes patients, praticiens et administrateurs.</p>
    </div>
    <a href="/admin/users/create" class="btn btn-primary fw-semibold">
      <i class="bi bi-person-plus me-1"></i> Ajouter un utilisateur
    </a>
  </div>

  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h2 class="h5 fw-bold mb-0 text-dark">
        <i class="bi bi-people-fill me-2 text-primary"></i>Liste des <%= users.length %> utilisateurs
      </h2>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">ID</th>
              <th>Utilisateur</th>
              <th>Email</th>
              <th>Rôle</th>
              <th>Détails</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td class="ps-4 fw-semibold text-muted">#<%= u.id %></td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(u.name) %>&background=005BAC&color=fff&size=64" class="rounded-circle" width="36" height="36" alt="Avatar">
                    <div>
                      <div class="fw-bold text-dark"><%= u.name %></div>
                      <small class="text-muted"><%= u.phone || '' %></small>
                    </div>
                  </div>
                </td>
                <td><span class="text-muted"><%= u.email %></span></td>
                <td>
                  <% if (u.role === 'admin') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Admin</span>
                  <% } else if (u.role === 'medecin') { %>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Médecin</span>
                  <% } else { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Patient</span>
                  <% } %>
                </td>
                <td>
                  <% if (u.role === 'medecin') { %>
                    <small class="text-muted d-block"><%= u.specialite %> — <%= u.centre_sante %></small>
                  <% } else if (u.role === 'patient') { %>
                    <small class="text-muted d-block"><%= u.address || 'Lomé' %></small>
                  <% } else { %>
                    <small class="text-muted d-block">Super-administrateur</small>
                  <% } %>
                </td>
                <td class="text-end pe-4">
                  <div class="d-flex justify-content-end gap-1">
                    <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-primary" title="Modifier">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <% if (u.id !== user.id) { %>
                      <form action="/admin/users/<%= u.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Confirmez-vous la suppression de cet utilisateur ?');" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-footer') %>
