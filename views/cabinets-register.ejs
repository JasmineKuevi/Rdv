<%- include('partials/header') %>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card soft-card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h3 fw-bold text-center mb-2">Inscrire votre établissement</h1>
                        <p class="text-muted text-center mb-4">Rejoignez le réseau Médilink pour moderniser la gestion de vos patients et rendez-vous.</p>

                        <form action="/inscrire-cabinet" method="POST">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label for="nom_hopital" class="form-label fw-semibold">Nom de l'hôpital ou du cabinet</label>
                                    <input type="text" class="form-control" id="nom_hopital" name="nom_hopital" placeholder="Ex: Clinique Lumière" required>
                                </div>
                                <div class="col-12">
                                    <label for="adresse" class="form-label fw-semibold">Adresse complète</label>
                                    <input type="text" class="form-control" id="adresse" name="adresse" placeholder="Ex: 45 Avenue de la Paix, Lomé" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="telephone" class="form-label fw-semibold">Téléphone</label>
                                    <input type="tel" class="form-control" id="telephone" name="telephone" placeholder="+228 22 00 11 22" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="email" class="form-label fw-semibold">Adresse e-mail professionnelle</label>
                                    <input type="email" class="form-control" id="email" name="email" placeholder="contact@clinique.tg" required>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 mt-4 fw-semibold">
                                <i class="bi bi-send me-2"></i>Envoyer la demande
                            </button>
                        </form>

                        <p class="text-center text-muted small mt-4 mb-0">
                            Déjà partenaire ?
                            <a href="/login?role=admin" class="text-decoration-none fw-semibold">Connectez-vous ici</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
