<%- include('partials/header') %>

<header class="bg-white border-bottom py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h1 class="section-title display-6 mb-2">Trouvez un médecin disponible</h1>
                <p class="lead text-muted mb-0">Recherchez par nom, spécialité ou ville, puis demandez un rendez-vous en ligne.</p>
            </div>
            <div class="col-lg-5">
                <form class="soft-card bg-white p-3 shadow-sm" method="GET" action="/medecins">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <input class="form-control" name="q" value="<%= query.q || '' %>" placeholder="Spécialité ou nom">
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" name="ville" value="<%= query.ville || '' %>" placeholder="Ville">
                        </div>
                        <div class="col-md-3 d-grid">
                            <button class="btn btn-primary"><i class="bi bi-search me-1"></i>Filtrer</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</header>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <% if (medecins && medecins.length > 0) { %>
                <% medecins.forEach(function(medecin) { %>
                    <div class="col-md-6 col-lg-3">
                        <article class="card soft-card h-100 border-0 shadow-sm">
                            <div class="card-body text-center p-4">
                                <img class="rounded-circle mb-3 border shadow-sm" width="92" height="92" alt="Dr <%= medecin.name %>" src="https://ui-avatars.com/api/?name=<%= encodeURIComponent('Dr ' + medecin.name) %>&background=075aa8&color=fff&size=120">
                                <h2 class="h5 fw-bold mb-1">Dr <%= medecin.name %></h2>
                                <p class="text-primary fw-semibold mb-2"><%= medecin.specialite %></p>
                                <p class="small text-muted mb-1"><i class="bi bi-hospital me-1"></i><%= medecin.centre_sante %></p>
                                <p class="small text-muted mb-3"><i class="bi bi-geo-alt me-1"></i><%= medecin.ville %></p>
                                <a class="btn btn-outline-primary w-100 fw-semibold" href="/rendez-vous/nouveau?doctor=<%= medecin.id %>">
                                    <i class="bi bi-calendar-plus me-1"></i> Prendre RDV
                                </a>
                            </div>
                        </article>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12">
                    <div class="soft-card bg-white p-5 text-center shadow-sm">
                        <i class="bi bi-search display-5 text-muted mb-3 d-block"></i>
                        <h2 class="h5 mt-2">Aucun médecin trouvé</h2>
                        <p class="text-muted">Essayez une autre spécialité ou une autre ville.</p>
                        <a class="btn btn-primary" href="/medecins">Réinitialiser les filtres</a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
