<!DOCTYPE html>
<html lang="fr" class="h-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> – Médilink</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root { --sidebar-width: 260px; }
        body { background-color: #f5f7fa; }
        .app-navbar { height: 56px; }
        .sidebar {
            width: var(--sidebar-width);
            top: 56px; bottom: 0; left: 0;
            position: fixed; background: #005BAC; color: #fff;
            padding: 1rem; overflow-y: auto; z-index: 1020;
        }
        .sidebar .nav-link { color: #e6eef7; border-radius: .375rem; margin-bottom: .25rem; }
        .sidebar .nav-link:hover { background: rgba(255,255,255,.12); color: #fff; }
        .sidebar .nav-link.active { background: #004a88; color: #fff; font-weight: 600; }
        .main {
            margin-left: var(--sidebar-width); padding: 1.5rem;
            min-height: calc(100vh - 56px);
            padding-top: 4.5rem;
        }
        @media (max-width: 991.98px) {
            .sidebar { display: none; }
            .main { margin-left: 0; }
        }
        .card-kpi .icon {
            width: 42px; height: 42px; display: grid; place-items: center;
            border-radius: .5rem; background: rgba(0,91,172,.08);
        }
    </style>
</head>
<body class="d-flex flex-column h-100">

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top app-navbar shadow-sm">
        <div class="container-fluid">
            <button class="btn btn-outline-light btn-sm d-lg-none me-2" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar" aria-controls="offcanvasSidebar">
                <i class="bi bi-list"></i> Menu
            </button>

            <a class="navbar-brand fw-semibold d-flex align-items-center gap-2" href="/">
                <img src="/logo.jpg" alt="Logo" width="28" height="28" class="rounded-circle" onerror="this.style.display='none'">
                <span>Médilink</span>
            </a>

            <div class="ms-auto d-flex align-items-center gap-3 me-2">
                <div class="dropdown">
                    <button class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-person-fill me-1"></i><%= user ? user.name : 'Utilisateur' %>
                        <span class="badge bg-light text-primary ms-1 text-uppercase" style="font-size: 0.7rem;"><%= user ? user.role : '' %></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li><h6 class="dropdown-header">Connecté en tant que <%= user ? user.email : '' %></h6></li>
                        <li>
                            <a class="dropdown-item" href="/">
                                <i class="bi bi-globe me-2"></i> Aller au site public
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form action="/logout" method="POST">
                                <button class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- SIDEBAR (desktop) -->
    <aside class="sidebar d-none d-lg-block">
        <%- include('sidebar-' + (user && user.role === 'admin' ? 'admin' : (user && user.role === 'medecin' ? 'medecin' : 'patient'))) %>
    </aside>

    <!-- OFFCANVAS SIDEBAR (mobile) -->
    <div class="offcanvas offcanvas-start text-bg-primary" tabindex="-1" id="offcanvasSidebar" aria-labelledby="offcanvasSidebarLabel">
        <div class="offcanvas-header border-bottom border-light border-opacity-25">
            <h5 class="offcanvas-title" id="offcanvasSidebarLabel">Médilink</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
        </div>
        <div class="offcanvas-body">
            <%- include('sidebar-' + (user && user.role === 'admin' ? 'admin' : (user && user.role === 'medecin' ? 'medecin' : 'patient'))) %>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <main class="main">
        <% if (messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i><%= messages.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        <% } %>
        <% if (messages.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i><%= messages.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        <% } %>
        <% if (messages.status) { %>
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle me-2"></i><%= messages.status %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        <% } %>
