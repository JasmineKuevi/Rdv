<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== 'undefined' ? title : 'Médilink' %> – Médilink</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        :root {
            --medilink-blue: #075aa8;
            --medilink-blue-dark: #08345f;
            --medilink-sky: #eaf5ff;
            --medilink-gold: #f6b93b;
            --medilink-ink: #122033;
        }

        body {
            padding-top: 70px;
            background: #f6f8fb;
            color: var(--medilink-ink);
            font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1 0 auto;
        }

        .public-navbar {
            background: rgba(7, 90, 168, .97);
            box-shadow: 0 10px 30px rgba(7, 36, 74, .16);
        }

        .public-navbar .navbar-brand {
            letter-spacing: .2px;
        }

        .public-navbar .nav-link {
            font-weight: 600;
        }

        .public-navbar .dropdown-menu {
            border: 0;
            border-radius: 8px;
            box-shadow: 0 18px 40px rgba(15, 34, 58, .15);
        }

        .section-title {
            color: var(--medilink-blue-dark);
            font-weight: 800;
        }

        .soft-card {
            border: 1px solid rgba(13, 59, 102, .08);
            border-radius: 8px;
            box-shadow: 0 12px 35px rgba(18, 32, 51, .08);
        }

        .btn-primary {
            background: var(--medilink-blue);
            border-color: var(--medilink-blue);
        }

        .btn-primary:hover {
            background: #064d90;
            border-color: #064d90;
        }

        .feature-icon {
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            border-radius: 8px;
            background: #eaf5ff;
            color: #075aa8;
            font-size: 1.35rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top public-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
                <img src="/logo.jpg" alt="Logo" width="30" height="30" class="rounded-circle" onerror="this.style.display='none'">
                <span>Médilink</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavbar" aria-controls="publicNavbar" aria-expanded="false" aria-label="Ouvrir le menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="publicNavbar">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Accueil</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle <%= ['/medecins', '/specialites', '/centres-de-sante'].includes(currentPath) ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Parcourir
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/medecins">Médecins</a></li>
                            <li><a class="dropdown-item" href="/specialites">Spécialités</a></li>
                            <li><a class="dropdown-item" href="/centres-de-sante">Centres de santé</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPath === '/aide' ? 'active' : '' %>" href="/aide">Aide</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link <%= currentPath === '/a-propos' ? 'active' : '' %>" href="/a-propos">À propos</a>
                    </li>
                </ul>

                <div class="d-flex align-items-lg-center gap-2 flex-column flex-lg-row">
                    <% if (user) { %>
                        <div class="dropdown">
                            <button class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i><%= user.name %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <% if (user.role === 'admin') { %>
                                        <a class="dropdown-item" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Espace Admin</a>
                                    <% } else if (user.role === 'medecin') { %>
                                        <a class="dropdown-item" href="/medecin/rendez-vous"><i class="bi bi-calendar-check me-2"></i>Mes RDV Médecin</a>
                                    <% } else { %>
                                        <a class="dropdown-item" href="/patient/dashboard"><i class="bi bi-speedometer2 me-2"></i>Mon Dashboard</a>
                                        <a class="dropdown-item" href="/patient/dossier"><i class="bi bi-file-medical me-2"></i>Mon Dossier</a>
                                        <a class="dropdown-item" href="/patient/profil"><i class="bi bi-person-gear me-2"></i>Mon Profil</a>
                                    <% } %>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="/logout" method="POST">
                                        <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    <% } else { %>
                        <a class="btn btn-outline-light btn-sm" href="/login?role=patient">Connexion</a>
                        <a class="btn btn-warning btn-sm fw-semibold" href="/register/patient">Créer un compte</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-2">
        <% if (messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle me-2"></i><%= messages.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        <% } %>
        <% if (messages.error) { %>
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i><%= messages.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        <% } %>
        <% if (messages.status) { %>
            <div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-info-circle me-2"></i><%= messages.status %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        <% } %>
    </div>

    <main>
