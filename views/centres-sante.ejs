<%- include('partials/header') %>

<header class="bg-white border-bottom py-5">
    <div class="container">
        <h1 class="section-title display-6">Centres de santé & Cliniques partenaires</h1>
        <p class="lead text-muted mb-0">Découvrez les structures médicales partenaires équipées de la solution Médilink.</p>
    </div>
</header>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <% centres.forEach(function(centre) { %>
                <div class="col-md-6 col-lg-3">
                    <div class="card soft-card h-100 p-4 border-0 shadow-sm">
                        <div class="feature-icon mb-3"><i class="bi bi-hospital"></i></div>
                        <h2 class="h5 fw-bold mb-2"><%= centre.name %></h2>
                        <p class="text-primary fw-semibold small mb-2"><i class="bi bi-geo-alt me-1"></i><%= centre.ville %></p>
                        <p class="text-muted small mb-4"><%= centre.services %></p>
                        <a class="btn btn-outline-primary btn-sm mt-auto" href="/medecins?ville=<%= encodeURIComponent(centre.ville) %>">
                            Voir l'équipe
                        </a>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
