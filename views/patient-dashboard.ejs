<%- include('partials/app-header') %>

<div class="container-fluid">
  <!-- Top header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">Bonjour, <%= user.name %> 👋</h1>
      <p class="text-muted mb-0">Bienvenue sur votre espace de santé Médilink.</p>
    </div>
    <a href="/rendez-vous/nouveau" class="btn btn-primary fw-semibold px-3 py-2 shadow-sm">
      <i class="bi bi-calendar-plus me-2"></i>Nouveau rendez-vous
    </a>
  </div>

  <!-- KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm p-3 h-100 bg-white">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold">Total rendez-vous</span>
            <h3 class="fw-bold mb-0 mt-1"><%= appointments.length %></h3>
          </div>
          <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
            <i class="bi bi-calendar-range fs-4"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm p-3 h-100 bg-white">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold">Confirmés</span>
            <h3 class="fw-bold mb-0 mt-1 text-success"><%= appointments.filter(a => a.status === 'confirmed').length %></h3>
          </div>
          <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
            <i class="bi bi-check2-circle fs-4"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm p-3 h-100 bg-white">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold">En attente</span>
            <h3 class="fw-bold mb-0 mt-1 text-warning"><%= appointments.filter(a => a.status === 'pending').length %></h3>
          </div>
          <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
            <i class="bi bi-clock-history fs-4"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm p-3 h-100 bg-white">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <span class="text-muted small fw-semibold">Dossier médical</span>
            <h3 class="fw-bold mb-0 mt-1 text-primary">À jour</h3>
          </div>
          <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
            <i class="bi bi-shield-check fs-4"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Rendez-vous list -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h2 class="h5 fw-bold mb-0 text-dark">
        <i class="bi bi-calendar3 me-2 text-primary"></i>Mes Rendez-vous médicaux
      </h2>
      <span class="badge bg-light text-dark border"><%= appointments.length %> consultation(s)</span>
    </div>

    <div class="card-body p-0">
      <% if (appointments.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Médecin & Spécialité</th>
                <th>Date & Heure</th>
                <th>Motif</th>
                <th>Statut</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% appointments.forEach(function(a) { %>
                <tr>
                  <td class="ps-4">
                    <div class="d-flex align-items-center gap-3">
                      <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent('Dr ' + a.doctor_name) %>&background=005BAC&color=fff&size=64" class="rounded-circle" width="40" height="40" alt="Médecin">
                      <div>
                        <div class="fw-bold text-dark">Dr <%= a.doctor_name %></div>
                        <small class="text-muted"><%= a.doctor_specialite %></small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark">
                      <%= new Date(a.scheduled_at).toLocaleDateString('fr-FR', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %>
                    </div>
                    <small class="text-muted">
                      <i class="bi bi-clock me-1"></i><%= new Date(a.scheduled_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %>
                    </small>
                  </td>
                  <td>
                    <span class="text-truncate d-inline-block" style="max-width: 260px;" title="<%= a.reason || 'Non spécifié' %>">
                      <%= a.reason || 'Consultation générale' %>
                    </span>
                  </td>
                  <td>
                    <% if (a.status === 'confirmed') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="bi bi-check-circle me-1"></i>Confirmé
                      </span>
                    <% } else if (a.status === 'pending') { %>
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                        <i class="bi bi-hourglass-split me-1"></i>En attente
                      </span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                        Effectué
                      </span>
                    <% } %>
                  </td>
                  <td class="text-end pe-4">
                    <form action="/rendezvous/<%= a.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Voulez-vous vraiment annuler ce rendez-vous ?');" style="display:inline;">
                      <button type="submit" class="btn btn-outline-danger btn-sm" title="Annuler le rendez-vous">
                        <i class="bi bi-x-circle me-1"></i>Annuler
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="bi bi-calendar-x text-muted display-4 d-block mb-3"></i>
          <h3 class="h5 text-dark">Aucun rendez-vous planifié</h3>
          <p class="text-muted">Prenez facilement rendez-vous avec un de nos médecins en ligne.</p>
          <a href="/rendez-vous/nouveau" class="btn btn-primary fw-semibold mt-2">
            <i class="bi bi-calendar-plus me-2"></i>Prendre mon premier RDV
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Quick Links & Tips -->
  <div class="row g-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm p-4 bg-white h-100">
        <h3 class="h5 fw-bold text-dark mb-3"><i class="bi bi-folder-check text-primary me-2"></i>Dossier Médical</h3>
        <p class="text-muted small mb-4">Consultez vos antécédents, vos prescriptions médicales et vos examens de laboratoire en toute sécurité.</p>
        <a href="/patient/dossier" class="btn btn-outline-primary mt-auto">
          Accéder à mon dossier médical
        </a>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm p-4 bg-white h-100">
        <h3 class="h5 fw-bold text-dark mb-3"><i class="bi bi-person-gear text-primary me-2"></i>Informations personnelles</h3>
        <p class="text-muted small mb-4">Mettez à jour vos coordonnées, vos contacts d'urgence et vos informations de mutuelle / assurance.</p>
        <a href="/patient/profil" class="btn btn-outline-primary mt-auto">
          Gérer mon profil
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/app-footer') %>
