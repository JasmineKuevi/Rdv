<%- include('partials/header') %>

<header class="bg-white border-bottom py-5">
    <div class="container">
        <h1 class="section-title display-6">Spécialités médicales</h1>
        <p class="lead text-muted mb-0">Découvrez l'ensemble des spécialités représentées sur la plateforme Médilink.</p>
    </div>
</header>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <% specialites.forEach(function(s) { %>
                <div class="col-md-6 col-lg-3">
                    <div class="card soft-card h-100 p-3 text-center border-0 shadow-sm">
                        <div class="card-body">
                            <img src="/images/<%= s.image %>" alt="<%= s.name %>" class="mb-3" width="60" height="60" style="object-fit:contain;" onerror="this.src='/images/cardio.png'">
                            <h2 class="h5 fw-bold mb-2"><%= s.name %></h2>
                            <p class="text-muted small mb-3"><%= s.desc %></p>
                            <a class="btn btn-outline-primary btn-sm w-100 fw-semibold" href="/medecins?q=<%= encodeURIComponent(s.name) %>">
                                Voir les médecins
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
